<Window x:Class="B2BIntegrator.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:B2BIntegrator.App"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- NBP Section (Row 0) -->
        <StackPanel Grid.Row="0" Margin="0, 0, 0, 40">
            <TextBlock Text="1. Kursy walut NBP (REST/JSON)" FontWeight="Bold" FontSize="16" Margin="0, 0, 0, 10" />
            <TextBlock Text="{Binding StatusMessage}" FontSize="14" Margin="0, 0, 0, 10" />
            <Button Content="Pobierz aktualny kurs USD" Command="{Binding FetchUsdRateCommand}" Padding="10, 5" Width="200" HorizontalAlignment="Left"/>
        </StackPanel>

        <!-- VIES Section (Row 1) -->
        <StackPanel Grid.Row="1">
            <TextBlock Text="2. Europejska weryfikacja VAT (SOAP/XML)" FontWeight="Bold" FontSize="16" Margin="0, 0, 0, 10" />

            <StackPanel Orientation="Horizontal" Margin="0, 0, 0, 10">
                <TextBox Text="{Binding CountryCode}" Width="40" Margin="0, 0, 10, 0" VerticalContentAlignment="Center" />
                <TextBox Text="{Binding VatNumber, UpdateSourceTrigger=PropertyChanged}" Width="150" Margin="0, 0, 10, 0" VerticalContentAlignment="Center" />
                <Button Content="Sprawdź NIP" Command="{Binding VerifyVatNumberCommand}" Padding="10, 5" Width="100" />
            </StackPanel>

            <TextBlock Text="{Binding ViesResult}" FontSize="14" Foreground="DarkBlue" TextWrapping="Wrap" />
        </StackPanel>
    </Grid>
</Window>
